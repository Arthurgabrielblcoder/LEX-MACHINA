+String normaJurisAtual()
+{
+  if(arquivoAtualPertenceACF()) return "CF88";
+#if LEX_DEVICE_V1_ENABLED
+  if(caminhoArquivoAtual==LEXV1_RUNTIME_CF_PATH) return "ADCT";   // runtime da CF, parte do ADCT (sub-namespace)
+#endif
+  for(size_t i=0;i<sizeof(NORMAS_JURIS)/sizeof(NORMAS_JURIS[0]);i++){
+    String pasta=String("/")+NORMAS_JURIS[i].pasta+"/";
+    if(!caminhoArquivoAtual.startsWith(pasta)) continue;
+    if(!NORMAS_JURIS[i].arquivo[0] || caminhoArquivoAtual.substring(pasta.length())==NORMAS_JURIS[i].arquivo) return NORMAS_JURIS[i].id;
+  }
+  return "";
+}
