+// ID = TRIBUNAL:CLASSE:NUMERO:...: o tribunal do ID deve estar na lista e ser o da coluna TRIBUNAL (fail closed). Legado STF inalterado.
+static bool tribunalJurisSuportado(const String &id, const String &tribunal)
+{
+  static const char *TRIBUNAIS[]={"STF","STJ","TSE","TST","STM"};
+  for(size_t i=0;i<sizeof(TRIBUNAIS)/sizeof(TRIBUNAIS[0]);i++)
+    if(tribunal==TRIBUNAIS[i] && id.startsWith(String(TRIBUNAIS[i])+":")) return true;
+  return false;
 }
 
