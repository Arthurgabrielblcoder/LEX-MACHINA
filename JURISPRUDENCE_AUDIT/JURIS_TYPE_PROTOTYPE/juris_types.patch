+// Classes processuais (tribunal separado da classe): TIPO minusculo do IDX -> rotulo. Nova classe = nova linha, sem novo enum.
+struct ClasseJurisRotulo { const char *tipo; const char *rotulo; };
+static const ClasseJurisRotulo CLASSES_JURIS[]={{"hc","HC"},{"habeas_corpus","HC"},{"rhc","RHC"},{"ms","MS"},{"rms","RMS"},{"ap","AP"},{"ai","AI"},{"inq","Inq"},{"rcl","Rcl"},{"mi","MI"},{"pet","Pet"},{"ado","ADO"},{"re","RE"},{"are","ARE"},{"ext","Ext"}};
+static const char *rotuloClasseJuris(const String &tipoMinusculo)
+{
+  for(size_t i=0;i<sizeof(CLASSES_JURIS)/sizeof(CLASSES_JURIS[0]);i++)
+    if(tipoMinusculo==CLASSES_JURIS[i].tipo) return CLASSES_JURIS[i].rotulo;
+  return nullptr;
+}
