 "fact_rules": [
  {
   "id": "SENADO_TRES_POR_UNIDADE_OITO_ANOS",
   "if_contains": "Senador",
   "must_not_contain": "\\b(?:dois|quatro) Senadores por|mandato de (?:quatro|seis) anos"
  },
  {
   "id": "LEGISLATURA_QUATRO_ANOS",
   "if_contains": "legislatura",
   "must_not_contain": "legislatura[^.]{0,30}\\b(?:cinco|oito) anos"
  },
  {
   "id": "MP_SESSENTA_MAIS_SESSENTA",
   "if_contains": "medida provis",
   "must_not_contain": "\\b(?:trinta|noventa) dias[^.]{0,20}prorrog"
  },
  {
   "id": "VETO_QUINZE_DIAS_UTEIS",
   "if_contains": "\\bveto",
   "must_not_contain": "\\b(?:dez|trinta) dias [úu]teis"
  },
  {
   "id": "TCU_NOVE_MINISTROS",
   "if_contains": "Tribunal de Contas da Uni",
   "must_not_contain": "\\b(?:sete|onze) Ministros"
  },
  {
   "id": "TCE_SETE_CONSELHEIROS",
   "if_contains": "conselheiros",
   "must_not_contain": "\\b(?:nove|cinco) conselheiros"
  },
  {
   "id": "TCU_IDADE_70",
   "if_contains": "trinta e cinco",
   "must_not_contain": "sessenta e cinco anos"
  },
  {
   "id": "INICIATIVA_POPULAR_UM_POR_CENTO",
   "if_contains": "iniciativa popular|eleitorado",
   "must_not_contain": "\\bdois por cento|\\bcinco por cento do eleitorado"
  },
  {
   "id": "IMUNIDADE_SEM_LICENCA_PREVIA",
   "if_contains": "den[úu]ncia|processo",
   "must_not_contain": "licen[çc]a pr[ée]via da Casa (?:[ée]|seja) (?:necess|exig)"
  },
  {
   "id": "DERRUBADA_VETO_MAIORIA_ABSOLUTA",
   "if_contains": "derrub",
   "must_not_contain": "dois ter[çc]os dos (?:deputados|parlamentares)[^.]{0,30}veto"
  }
 ],
