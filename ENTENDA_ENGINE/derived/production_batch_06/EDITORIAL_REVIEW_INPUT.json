 "resolutions": {
  "CF88:ART.42:PAR.3": {
   "EXCEPTION_NOT_IN_TEXT": "Falso positivo: \"exceções\" descreve as hipoteses do art. 37, XVI, para o qual o § 3º remete; nao cria excecao propria."
  },
  "CF88:ART.43": {
   "ABSOLUTE_CLAIM": "Falso positivo: \"sempre que possível\" reproduz a expressao do § 4º, que e justamente uma ressalva (nao absoluta)."
  },
  "CF88:ART.47": {
   "TRANSITION_IN_CORE": "Falso positivo: \"emenda constitucional\" designa a especie normativa (quorum de tres quintos), nao regra de transicao nem historico de redacao."
  },
  "CF88:ART.55:INC.VI": {
   "ABSOLUTE_CLAIM": "Falso positivo: frase negativa (\"e não declarada automaticamente\"), que justamente afasta efeito automatico."
  },
  "CF88:ART.57:PAR.2": {
   "EXAMPLE_NUMBER": "Data \"17 de julho\" vem do caput do art. 57 (fim do primeiro periodo), contexto do § 2º; nao e numero inventado."
  },
  "CF88:ART.57:PAR.7": {
   "ABSOLUTE_CLAIM": "Fiel ao texto: o § 8º diz que as medidas provisorias em vigor serao automaticamente incluidas na pauta."
  },
  "CF88:ART.58": {
   "LAW_DEPENDENCY_OMITTED": "Falso positivo: \"de lei\" no texto e parte de \"projeto de lei\" (competencia das comissoes), nao dependencia de lei."
  },
  "CF88:ART.58:PAR.2": {
   "LAW_DEPENDENCY_OMITTED": "Falso positivo: \"de lei\" no texto e parte de \"projeto de lei\", nao dependencia de lei."
  },
  "CF88:ART.62": {
   "MODALITY_SHIFT": "Fiel ao texto: o caput diz \"devendo submetê-las de imediato ao Congresso Nacional\"; a obrigacao e textual."
  },
  "CF88:ART.64:PAR.2": {
   "EXCEPTION_NOT_IN_TEXT": "Falso positivo do detector: o § 2º diz \"com exceção das que tenham prazo constitucional determinado\" (\"exceção\" nao esta na lista de marcadores)."
  },
  "CF88:ART.71": {
   "LAW_DEPENDENCY_OMITTED": "Dependencia de lei e do inciso VIII (sancoes previstas em lei), que tem explicacao propria (ITEM) mencionando a lei."
  },
  "CF88:ART.74": {
   "LAW_DEPENDENCY_OMITTED": "\"Na forma da lei\" e do § 2º (denuncia ao TCU), que tem explicacao propria (DEVICE) mencionando a lei."
  }
 }
}
