 },
 "stale": {
  "snapshot": "texto oficial atual da subarvore do target (uma linha por dispositivo: target_id TAB texto), gravado no registro",
  "hash": "source_text_sha256 do snapshot + context_text_sha256 do texto proprio de cada context_target",
  "states": [
   "FRESH",
   "STALE_TEXT_CHANGED",
   "STALE_CONTEXT_CHANGED",
   "ORPHANED_TARGET",
   "NO_EXPLANATION"
  ],
  "stamp_rule": "registro ja carimbado mantem o hash original; mudar conteudo exige novo editorial_version",
  "build": "freshness vai para o lookup e o payload (F|...); o firmware pode avisar ou ocultar"
 },
 "explanation_id": {
  "format": "ENTENDA/<target_id>/<VARIANT>/<editorial_version>",
  "example": "ENTENDA/CF88:ART.37:PAR.6/BASE/1",
  "key": "ENTENDA/<target_id>/<VARIANT> (estavel entre versoes)",
  "path_independent": true
 },
 "storage": {
  "options": {
   "jsonl_por_norma": "fonte editorial canonica: 1 linha por explicacao; diff/merge por linha; atualizacao incremental; streaming",
   "json_unico": "exige carregar e reescrever tudo; diffs ruins; inviavel na RAM do ESP32",
   "arquivo_por_target": "dezenas de milhares de arquivos pequenos no FAT32 (clusters desperdicados, diretorios lentos, updater caro)"
  },
  "recommendation": "corpus JSONL por norma (fonte) + par ENTENDA_LOOKUP.IDX / ENTENDA_PAYLOAD.DAT por norma (SD), gerado deterministicamente",
  "lookup_line": "TARGET_ID|OFFSET|BYTES|EXPLANATION_ID|VALIDITY|FRESHNESS|REVIEW (ordenado ASCII)",
  "payload_block": "@ID / T|K|V|R|F|H|C|N|W / #O QUE DIZ ... #PALAVRAS DIFICEIS (termo|explicacao) / #CAMADAS EXTERNAS / @END"
 },
 "esp32": {
  "buffer": "um bloco por vez; maximo de 6144 bytes validado; piloto <= 2858 bytes",
  "lookup": "busca binaria por seek no arquivo (sem carregar tudo na RAM); CF recomendada ~[53, 81] KB",
  "read": "seek(OFFSET) + read(BYTES): leitura unica e limitada",
  "render": "texto UTF-8 com acentos; secoes marcadas por #; paginacao na tela",
  "key": "mesmo target_id canonico das Referencias (namespace obrigatorio; ADCT separado)",
  "future": "se o lookup de uma norma grande passar de ~100 KB, usar registros de largura fixa ou indice em dois niveis",
  "implemented": false
 },
