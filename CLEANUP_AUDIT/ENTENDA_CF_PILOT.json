  },
  "context_targets": "cadeia estrutural completa do artigo ate o pai direto (declarada e validada); sem heranca automatica de conteudo",
  "caput_rule": "CAPUT so recebe explicacao propria quando o artigo tem paragrafos e o caput traz comando distinto da visao geral; caso contrario a unidade e o ARTIGO",
  "not_eligible": [
   "NORMA",
   "NAMESPACE"
  ]
 },
