bool iniciarSDUmaVez()
{
  digitalWrite(TFT_CS,HIGH);
  digitalWrite(SD_CS,HIGH);
  sdOK=SD.begin(SD_CS,spiBus,12000000);
  if(!sdOK){
    SD.end();
    sdOK=SD.begin(SD_CS,spiBus,4000000);
  }
